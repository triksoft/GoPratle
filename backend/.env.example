# MongoDB Atlas connection string. Never commit the real value.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Comma-separated production frontend origins. Do not include a trailing slash.
CLIENT_ORIGINS=http://localhost:3000
# Port is optional; Render supplies PORT automatically.
PORT=5000
NODE_ENV=development
